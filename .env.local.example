# Local development environment (run backend from IDE).
# Usage:
# 1) Copy to .env.local
# 2) Start dependencies: docker compose up -d
# 3) Run app from IDE with env file .env.local

SPRING_PROFILES_ACTIVE=local

# URLs / CORS
APP_BASE_URL=http://localhost:5173
JWT_PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
JWT_CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_TRUST_PROXY=false

# Database (from compose.yaml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=interhubdev
DB_USER=interhubdev
DB_PASSWORD=interhubdev

# Redis (from compose.yaml)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# JWT / bootstrap admin (local-safe defaults)
JWT_SECRET=local-dev-secret-change-me-min-32-chars
ADMIN_EMAIL=admin@interhubdev.local
ADMIN_PASSWORD=admin12345
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin

# Mail (disabled by local profile; values optional)
MAIL_ENABLED=false
MAIL_LOG_ONLY=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@interhubdev.local
MAIL_FROM_NAME=InterHubDev Local
MAIL_USE_STARTTLS=false
MAIL_USE_SSL=false

# MinIO (from compose.yaml)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documents
MINIO_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ClamAV (from compose.yaml)
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
